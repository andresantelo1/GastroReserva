# Plantilla LOCAL de hosting estático. No está instalada ni publicada.
# Para internet: configurar dominio, HTTPS/certificado y API HTTPS real antes de publicar.
server {
    listen 8088;
    server_name localhost;
    root /srv/gastroreserva/dist;
    index index.html;

    # Esta variante usa API en otro origen, no proxy de Spring.
    location /api/ { return 404; }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
